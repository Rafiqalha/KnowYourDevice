{
  "name": "knowyourdevice-desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Kenali perangkatmu. Inventaris hardware Windows yang jernih dan privat.",
  "author": "Rafiqalha",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:native \u0026\u0026 npm run typecheck \u0026\u0026 vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "package": "node ../scripts/collect-notices.cjs \u0026\u0026 electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "id.rafiqalha.knowyourdevice",
    "productName": "KnowYourDevice",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../build/native",
        "to": "native",
        "filter": [
          "*.exe",
          "*.config"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "KnowYourDevice-${version}-Windows-x64.exe",
      "requestExecutionLevel": "user"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
